
N = 4

def is_safe(board, row, col):
    # Check upper column
    for i in range(row):
        if board[i][col] == 1:
            return False

    # Check upper-left diagonal
    i, j = row - 1, col - 1
    while i >= 0 and j >= 0:
        if board[i][j] == 1:
            return False
        i -= 1
        j -= 1

    # Check upper-right diagonal
    i, j = row - 1, col + 1
    while i >= 0 and j < N:
        if board[i][j] == 1:
            return False
        i -= 1
        j += 1

    return True


def solve_nqueen(board, row):
    if row == N:
        for r in board:
            print(" ".join(map(str, r)))
        print()
        return

    for col in range(N):
        if is_safe(board, row, col):
            board[row][col] = 1
            solve_nqueen(board, row + 1)
            board[row][col] = 0  # Backtracking


board = [[0] * N for _ in range(N)]
solve_nqueen(board, 0)
